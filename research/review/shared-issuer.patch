+        write_report(b'[1]\n')
+        self.git("commit", "--quiet", "-am", "Different claims and report")
+        changed, _ = capture_sces(self.source, self.git("rev-parse", "HEAD"))
+        for field in ("tree", "inventory_sha256"):
+            self.assertNotEqual(changed[field], first[field])
+        self.assertNotEqual(changed["artifacts"][artifact], first["artifacts"][artifact])
+

