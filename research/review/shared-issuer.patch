@@ -0,0 +1,466 @@
+"""Synthetic Git-object fixtures for the protected SCES review inputs."""
+
+from base64 import b64encode
+from hashlib import sha256
+from io import BytesIO
+from pathlib import Path
+from subprocess import CompletedProcess, TimeoutExpired
+from tempfile import TemporaryDirectory
+from types import SimpleNamespace
+import unittest
+from unittest.mock import MagicMock, patch
+
+from tools.qualification import POLICY_DIGEST, _blob_hash, _canonical
+from tools.records import DataError, NoRedirects, decode, encode
+from tools.review_evidence import _fetch_frozen_records, _inventory, _retrieve_frozen_records, capture_selected_evidence
+from tools.review_snapshot import LANGUAGE, SnapshotError, _GIT_TIMEOUT, _git, _isolated_git_environment, remote_url
+
+
+REPOSITORY = LANGUAGE.repository
+SELECTION = "sces/publication.json"
+RELEASE = "sces/releases/test-release/"
+CLAIM = "sces/records/claim/selected--1.json"
+UNSELECTED = "sces/records/claim/unselected--1.json"
+SOURCE_ARTIFACT = "sces/artifacts/citation.txt"
+REVIEW = "sces/records/verification/selected-review--1.json"
+
+
+def ref(kind, name):
+    return {"kind": kind, "id": name, "revision": 1}
+
+
+def digest(blob):
+    return sha256(blob).hexdigest()
+
+
+def fixture():
+    inputs = {"sces/adoption.json": _canonical({"policy": "SCES-1.0", "policy_sha256": POLICY_DIGEST,
+                                               "mode": "index", "repository": REPOSITORY}),
+              SOURCE_ARTIFACT: b"Exact inherited citation bytes.\n"}
+
+    def record(identity, **data):
+        path = f"sces/records/{identity['kind']}/{identity['id']}--1.json"
+        row = {**identity, **data}
+        inputs[path] = _canonical(row)
+        return row
+
+    origin = ref("source", "original")
+    upstream = ref("source", "upstream")
+    record(origin, upstream=[upstream], artifact={"path": SOURCE_ARTIFACT, "sha256": digest(inputs[SOURCE_ARTIFACT])})
+    record(upstream, upstream=[])
+    summaries = []
+    selected = ref("claim", "selected")
+    premise = ref("claim", "premise")
+    selected_row = record(selected, value="selected value")
+    record(premise, value="supporting premise")
+    selected_dependency = record(ref("dependency", "selected-premise"), claim=selected, basis=premise, relation="premise")
+    record(ref("dependency", "premise-origin"), claim=premise, basis=origin, relation="support")
+    record(ref("conflict", "selected-conflict"), claim=selected)
+    for claim in (premise, selected):
+        name = claim["id"]
+        executions = {}
+        for phase, suffix in (("research", "research"), ("independent-review", "review")):
+            run = name + "-" + suffix
+            identity = ref("verification", run)
+            trace_path = f"sces/artifacts/{run}.jsonl"
+            inputs[trace_path] = b'{"fixture":"inert trace"}\n'
+            row = record(identity, claim=claim, phase=phase, conclusion="supported", run={
+                "execution": run, "completed": "2026-10-01T00:00:00Z",
+                "trace": {"path": trace_path, "sha256": digest(inputs[trace_path])},
+            })
+            summaries.append({"record": identity, "phase": phase, "execution": run,
+                              "result": "supported", "record_sha256": digest(_canonical(row))})
+            executions[suffix] = identity
+        record(ref("disposition", name + "-disposition"), target=claim, evidence="supported",
+               verification="independently-reviewed", **executions)
+    selection = {"release": "test-release", "dataset": "test-index", "schema_version": "1.0.0",
+                 "source_commit": "b" * 40, "claims": [selected]}
+    selection_bytes = _canonical(selection)
+    claims_bytes = _canonical([{"claim": selected_row, "dependencies": [selected_dependency]}])
+    report = {**selection, "policy": "SCES-1.0", "policy_sha256": POLICY_DIGEST, "synthetic": False,
+              "repository": REPOSITORY, "selection_sha256": digest(selection_bytes), "verifications": summaries,
+              "artifacts": [{"path": RELEASE + "claims.json", "sha256": digest(claims_bytes)}],
+              "inputs_sha256": digest(_canonical({path: digest(raw) for path, raw in inputs.items()}))}
+    publication = {SELECTION: selection_bytes, RELEASE + "claims.json": claims_bytes,
+                   RELEASE + "qualification.json": _canonical(report)}
+    return inputs, publication
+
+
+def pin_source(publication, commit):
+    report_path = RELEASE + "qualification.json"
+    selection = _canonical({**decode(publication[SELECTION]), "source_commit": commit})
+    report = {**decode(publication[report_path]), "source_commit": commit, "selection_sha256": digest(selection)}
+    return {**publication, SELECTION: selection, report_path: _canonical(report)}
+
+
+def select_release(publication, slug, predecessor=None):
+    selection = {**decode(publication[SELECTION]), "release": slug}
+    report = {**decode(publication[RELEASE + "qualification.json"]), "release": slug}
+    if predecessor is not None:
+        selection["previous_report"] = report["previous_report"] = predecessor
+    selection_bytes = _canonical(selection)
+    claims = publication[RELEASE + "claims.json"]
+    release_path = f"sces/releases/{slug}/"
+    report["selection_sha256"] = digest(selection_bytes)
+    report["artifacts"] = [{"path": release_path + "claims.json", "sha256": digest(claims)}]
+    return {SELECTION: selection_bytes, release_path + "claims.json": claims,
+            release_path + "qualification.json": _canonical(report)}
+
+
+class CaptureSelectedEvidenceTests(unittest.TestCase):
+    def setUp(self):
+        temp = TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.root = Path(temp.name)
+        _git(self.root, "init", "--quiet", "--template=")
+
+    def commit(self, files, message):
+        for path, blob in files.items():
+            destination = self.root / path
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            destination.write_bytes(blob)
+        _git(self.root, "add", "sces")
+        _git(self.root, "commit", "--quiet", "-m", message,
+             config=("user.name=Synthetic review fixture", "user.email=fixture@example.invalid", "commit.gpgsign=false"))
+        return _git(self.root, "rev-parse", "HEAD").decode("ascii").strip()
+
+    def capture(self, candidate):
+        base = _git(self.root, "rev-parse", candidate + "^1").decode("ascii").strip()
+        return capture_selected_evidence(self.root, candidate, LANGUAGE, base=base)
+
+    def test_selection_only_commit_stages_unchanged_closure_but_no_unrelated_records(self):
+        inputs, publication = fixture()
+        baseline = self.commit({**inputs, UNSELECTED: _canonical(ref("claim", "unselected"))}, "inherited evidence")
+        self.assertEqual(capture_selected_evidence(self.root, baseline, LANGUAGE), {})
+        publication = pin_source(publication, baseline)
+        candidate = self.commit(publication, "select previously committed evidence")
+        changed = _git(self.root, "diff", "--name-only", baseline, candidate).decode().splitlines()
+        self.assertNotIn(CLAIM, changed)
+        self.assertNotIn(REVIEW, changed)
+        staged = self.capture(candidate)
+        self.assertEqual(staged, {**inputs, **publication})
+        self.assertNotIn(UNSELECTED, staged)
+
+    def test_successor_requires_the_direct_base_report_at_its_unchanged_bytes(self):
+        inputs, publication = fixture()
+        source = self.commit(inputs, "freeze evidence")
+        publication = pin_source(publication, source)
+        older_path = "sces/releases/older/qualification.json"
+        older = select_release(publication, "older")
+        self.commit(older, "publish an older release")
+        older_link = {"path": older_path, "sha256": digest(older[older_path])}
+        current = select_release(publication, "current", older_link)
+        base = self.commit(current, "publish the direct predecessor")
+        path = "sces/releases/current/qualification.json"
+        original = current[path]
+        direct_link = {"path": path, "sha256": digest(original)}
+        successor = select_release(publication, "test-release", direct_link)
+        candidate = self.commit(successor, "use the direct predecessor")
+        self.assertEqual(self.capture(candidate)[path], original)
+        unchanged = self.commit({"sces/artifacts/unrelated.txt": b"unrelated\n"}, "preserve active selection")
+        self.assertEqual(self.capture(unchanged)[path], original)
+
+        _git(self.root, "switch", "--quiet", "--detach", candidate)
+        rewrite = self.commit(select_release(publication, "test-release", older_link), "change active lineage")
+        with self.assertRaisesRegex(DataError, "active publication selection differs"):
+            self.capture(rewrite)
+
+        replacement = _canonical({**decode(original), "fixture": "replacement"})
+        replacement_link = {"path": path, "sha256": digest(replacement)}
+        for link, extra, message in (
+            (None, {}, "successor must identify the verified base release"),
+            (older_link, {}, "successor must identify the verified base release"),
+            (replacement_link, {path: replacement}, "previous report path or blob differs"),
+        ):
+            with self.subTest(link=link):
+                _git(self.root, "switch", "--quiet", "--detach", base)
+                candidate = self.commit({**select_release(publication, "test-release", link), **extra},
+                                        "write successor with matching internal hashes")
+                with self.assertRaisesRegex(DataError, message):
+                    self.capture(candidate)
+
+    def test_inactive_base_requires_an_exact_withdrawal_advisory_for_archived_lineage(self):
+        inputs, publication = fixture()
+        source = self.commit(inputs, "freeze evidence")
+        publication = pin_source(publication, source)
+        archived = select_release(publication, "withdrawn")
+        path = "sces/releases/withdrawn/qualification.json"
+        advisory = "sces/advisories/withdrawn.json"
+        link = {"path": path, "sha256": digest(archived[path])}
+        successor = select_release(publication, "test-release", link)
+        del archived[SELECTION]
+        unadvised = self.commit(archived, "archive report without withdrawal advisory")
+        candidate = self.commit(successor, "claim unadvised archived lineage")
+        with self.assertRaisesRegex(DataError, "requires an unchanged withdrawal advisory"):
+            self.capture(candidate)
+
+        advice = {"report": link, "affected": [ref("claim", "selected")], "reason": "Synthetic withdrawal",
+                  "recorded": "2026-10-01T00:00:00Z"}
+        _git(self.root, "switch", "--quiet", "--detach", unadvised)
+        unbound = {**advice, "report": {**link, "sha256": "f" * 64}}
+        self.commit({advisory: _canonical(unbound)}, "archive advisory with a different subject digest")
+        candidate = self.commit(successor, "claim lineage to an unbound archived report")
+        with self.assertRaisesRegex(DataError, "withdrawal advisory does not bind the archived predecessor"):
+            self.capture(candidate)
+
+        _git(self.root, "switch", "--quiet", "--detach", unadvised)
+        self.commit({advisory: _canonical(advice)}, "record withdrawal on the protected base")
+        candidate = self.commit(successor, "link to the advised withdrawn archive")
+        captured = self.capture(candidate)
+        self.assertEqual(captured[path], archived[path])
+        self.assertEqual(captured[advisory], _canonical(advice))
+        with self.assertRaisesRegex(DataError, "requires the exact verified pull-request base"):
+            capture_selected_evidence(self.root, candidate, LANGUAGE)
+
+    def test_selected_claim_and_inherited_premise_require_independent_execution_pairs(self):
+        baseline = self.commit({"sces/artifacts/fixture.txt": b"fixture\n"}, "prepare independent fixtures")
+        for name, execution in (("selected", "selected-research"), ("premise", "premise-research"),
+                                ("premise", ""), ("premise", " ")):
+            with self.subTest(name=name, execution=execution):
+                _git(self.root, "switch", "--quiet", "--detach", baseline)
+                inputs, publication = fixture()
+                review = f"{name}-review"
+                record_path = f"sces/records/verification/{review}--1.json"
+                row = decode(inputs[record_path])
+                row["run"]["execution"] = execution
+                inputs[record_path] = _canonical(row)
+                source = self.commit(inputs, "freeze evidence with invalid execution pair")
+                publication = pin_source(publication, source)
+                report_path = RELEASE + "qualification.json"
+                report = decode(publication[report_path])
+                report["inputs_sha256"] = digest(_canonical({path: digest(raw) for path, raw in inputs.items()}))
+                for summary in report["verifications"]:
+                    if summary["record"]["id"] == review:
+                        summary.update(execution=execution, record_sha256=digest(inputs[record_path]))
+                candidate = self.commit({**publication, report_path: _canonical(report)}, "qualify matching records")
+                with self.assertRaisesRegex(DataError, "distinct nonempty research and review executions"):
+                    self.capture(candidate)
+
+    def test_unreferenced_uppercase_file_is_allowed_but_uppercase_descriptor_is_not(self):
+        inputs, publication = fixture()
