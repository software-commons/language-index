{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/software-commons/language-index/blob/main/schemas/domain/registry-v1.schema.json",
  "title": "Language Index registry version 1",
  "oneOf": [
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/coverage"
    }
  ],
  "$defs": {
    "claimRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "kind": {
          "const": "claim"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "claim"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claim": {
          "$ref": "#/$defs/claimRef"
        }
      }
    },
    "localTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "externalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "index": {
          "type": "string",
          "pattern": "^software-commons/[a-z0-9-]+-index$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[a-z0-9.-]+)?)$"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "claim"
      ],
      "properties": {
        "type": {
          "enum": [
            "dialect-of",
            "edition-of",
            "member-of",
            "derived-from",
            "forked-from",
            "supersedes",
            "split-from",
            "merged-from",
            "implemented-by",
            "external"
          ]
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/localTarget"
            },
            {
              "$ref": "#/$defs/externalTarget"
            }
          ]
        },
        "claim": {
          "$ref": "#/$defs/claimRef"
        }
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "revision",
        "key",
        "claim"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claim": {
          "$ref": "#/$defs/claimRef"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "aliases",
        "state",
        "identity_claim",
        "relations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "enum": [
            "language",
            "family",
            "dialect",
            "edition",
            "implementation"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "identity_claim": {
          "$ref": "#/$defs/claimRef"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "crosswalks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crosswalk"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "origins",
        "disposition",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "disposition": {
          "enum": [
            "canonical",
            "dialect",
            "family",
            "alias",
            "implementation",
            "out-of-scope",
            "duplicate",
            "rejected",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "entity": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimRef"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "canonical",
                  "dialect",
                  "family",
                  "alias",
                  "implementation",
                  "duplicate"
                ]
              }
            }
          },
          "then": {
            "required": [
              "entity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "out-of-scope",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "campaign",
        "cutoff",
        "scope",
        "method",
        "limitations"
      ],
      "properties": {
        "snapshot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "campaign": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "cutoff": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
